HOST=127.0.0.1
PORT=8000
REACHOUT_DB=reachout.sqlite3
REACHOUT_SOURCES_CONFIG=config/sources.json
REACHOUT_WORKSPACE_CONFIG=config/workspace.json
REACHOUT_EVENT_MAX_AGE_DAYS=30
LOG_LEVEL=INFO
# Research defaults to deterministic test data. A live call occurs only when
# the Event Room action explicitly selects Grok.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low
RESEARCH_SEARCH_LIMIT=1
RESEARCH_TOKEN_LIMIT=4000
RESEARCH_TIMEOUT_SECONDS=60
RESEARCH_MAX_RETRIES=1
RESEARCH_WORKERS=2
# Verification search is only invoked by the explicit Find corroboration action.
VERIFICATION_SEARCH_TURNS=1
VERIFICATION_TOKEN_LIMIT=1200
VERIFICATION_TIMEOUT_SECONDS=75
VERIFICATION_MAX_RETRIES=0
VERIFICATION_MAX_LEADS=5
# Future publishing integrations, intentionally unused:
# META_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
