HOST=127.0.0.1
PORT=8000
REACHOUT_DB=reachout.sqlite3
REACHOUT_SOURCES_CONFIG=config/sources.json
REACHOUT_WORKSPACE_CONFIG=config/workspace.json
REACHOUT_EVENT_MAX_AGE_DAYS=30
LOG_LEVEL=INFO
# Research defaults to deterministic test data. A live call occurs only when
# the Event Room action explicitly selects Grok.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low
RESEARCH_SEARCH_LIMIT=1
RESEARCH_TOKEN_LIMIT=4000
RESEARCH_TIMEOUT_SECONDS=60
RESEARCH_MAX_RETRIES=1
RESEARCH_WORKERS=2
# Verification search is only invoked by the explicit Find corroboration action.
VERIFICATION_SEARCH_TURNS=1
VERIFICATION_TOKEN_LIMIT=1200
# Bounded phase budgets: search response, each source-retrieval phase, and one
# end-to-end execution. Only transient transport/provider failures get one retry.
VERIFICATION_SEARCH_TIMEOUT_SECONDS=180
VERIFICATION_RETRIEVAL_TIMEOUT_SECONDS=30
VERIFICATION_TOTAL_TIMEOUT_SECONDS=300
VERIFICATION_TRANSIENT_RETRIES=1
VERIFICATION_RETRY_BACKOFF_SECONDS=2
VERIFICATION_RETRY_MAX_BACKOFF_SECONDS=30
VERIFICATION_MAX_LEADS=5
# Content CEO calls a provider only after its deterministic evidence gate passes.
CONTENT_POLICY_VERSION=content-ceo-v1.1
CONTENT_FRESHNESS_DAYS=7
CONTENT_HISTORY_DAYS=30
CONTENT_TOKEN_LIMIT=900
CONTENT_TIMEOUT_SECONDS=45
# Content production is an explicit one-call Anthropic action. The default
# model is centralized here and may be changed without editing application code.
ANTHROPIC_API_KEY=
# Live packages always use Claude; fixture packages are accepted by the API only in explicit demo mode.
REACHOUT_DEMO_MODE=
# CLAUDE_PRODUCTION_MODEL takes precedence over ANTHROPIC_MODEL when set.
CLAUDE_PRODUCTION_MODEL=claude-opus-4-5-20251101
ANTHROPIC_MODEL=claude-opus-4-5-20251101
ANTHROPIC_VERSION=2023-06-01
PRODUCTION_POLICY_VERSION=content-production-v1
PRODUCTION_TOKEN_LIMIT=8000
PRODUCTION_CONNECTION_TIMEOUT_SECONDS=10
PRODUCTION_RESPONSE_TIMEOUT_SECONDS=60
PRODUCTION_MAX_RETRIES=0
# Local rate estimates are intentionally not represented as actual cost.
# Anthropic usage is stored, while absent provider-reported cost remains unknown.
# Media rendering is opt-in. Leave providers blank until a supported live
# adapter and its credentials are configured. Fixture rendering is test-only.
# Supported live adapter: RENDERER_PROVIDER_IMAGE=xai (still images only).
# Paid rendering requires RENDERER_PROVIDER_IMAGE=xai explicitly. LIVE_RENDERER_API_KEY is
# optional: when blank, the xAI renderer reuses XAI_API_KEY internally. Never commit a real key.
RENDERER_PROVIDER_IMAGE=
RENDERER_PROVIDER_VIDEO=
RENDERER_PROVIDER_AUDIO=
LIVE_RENDERER_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_IMAGE_RESOLUTION=2k
XAI_IMAGE_QUALITY=medium
# Video (RENDERER_PROVIDER_VIDEO=xai). The model is validated against GET /v1/video-generation-models
# before any paid submission; each video requires an explicit click and stops at human review.
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_VIDEO_RESOLUTION=720p
XAI_VIDEO_POLL_INTERVAL_SECONDS=5
XAI_VIDEO_MAX_POLL_ATTEMPTS=120
XAI_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=180
XAI_VIDEO_MAX_SOURCE_BYTES=20971520
# Immutable image-to-video derivatives are prepared locally before a paid call.
# They preserve aspect ratio, never crop/stretch, and fail closed above this size.
VIDEO_SOURCE_MAX_BYTES=4194304
VIDEO_SOURCE_MIN_SHORT_SIDE=720
RENDER_MIN_VIDEO_SHORT_SIDE=360
RENDER_VIDEO_DURATION_TOLERANCE_SECONDS=1.5
LIVE_RENDERER_TIMEOUT_SECONDS=180
LIVE_RENDERER_MAX_RETRIES=1
RENDER_BACKOFF_SECONDS=2
RENDER_MAX_BACKOFF_SECONDS=30
LIVE_RENDERER_POLL_INTERVAL_SECONDS=2
LIVE_RENDERER_MAX_POLL_ATTEMPTS=30
RENDERER_CONFIG_VERSION=live-renderer-config-v1
MEDIA_QA_POLICY_VERSION=media-qa-v1
# Local macOS OCR/frame extraction is free and uses Apple Vision/AVFoundation.
OCR_PROVIDER=auto
VIDEO_FRAME_EXTRACTOR=auto
# auto uses Claude when ANTHROPIC_API_KEY is configured; otherwise visual QA is UNKNOWN.
VISUAL_QA_PROVIDER=auto
CLAUDE_QA_MODEL=claude-opus-4-5-20251101
VISUAL_QA_TIMEOUT_SECONDS=120
RENDER_POLICY_VERSION=media-render-policy-v1
RENDER_PROMPT_VERSION=media-render-prompt-v1
RENDER_GENERATION_CONFIG_VERSION=media-render-config-v1
RENDER_STORAGE_ROOT=.context/generated_media
RENDER_TIMEOUT_SECONDS=90
RENDER_MAX_RETRIES=1
RENDER_WORKERS=1
RENDER_MIN_IMAGE_WIDTH=1080
RENDER_MIN_IMAGE_HEIGHT=1080
RENDER_ASPECT_TOLERANCE=0.03
# Future publishing integrations, intentionally unused:
# META_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=

# Meta distribution (Instagram Reels / Facebook Reels). Live posting is OFF until all three
# conditions hold: media APPROVED + platform package APPROVED + these switches ON.
SOCIAL_PUBLISHING_ENABLED=0
INSTAGRAM_PUBLISHING_ENABLED=0
FACEBOOK_PUBLISHING_ENABLED=0
META_GRAPH_API_VERSION=v25.0
# Instagram API with Instagram Login (graph.instagram.com): permissions instagram_business_basic,
# instagram_business_content_publish. With Facebook Login use INSTAGRAM_GRAPH_HOST=graph.facebook.com and
# instagram_basic, instagram_content_publish, pages_read_engagement (Page-linked professional account).
INSTAGRAM_GRAPH_HOST=graph.instagram.com
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Facebook Page Reels: Page access token from a user with CREATE_CONTENT on the Page;
# permissions pages_show_list, pages_read_engagement, pages_manage_posts.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_STATUS_POLL_INTERVAL_SECONDS=30
META_STATUS_MAX_POLLS=10
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_RETRY_BACKOFF_SECONDS=5
PUBLISH_SCHEDULER_INTERVAL_SECONDS=30
DISTRIBUTION_STATIC_HASHTAGS=
